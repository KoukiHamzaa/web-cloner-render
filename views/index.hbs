<header>
  <div aria-busy="true" id="progress" hidden aria-label="Downloading" role="progressbar"></div>
</header>

<main role="main">
  <section class="downloader-card" aria-labelledby="page-title">
    <img class="brand-mark" src="https://www.google.com/inbox/assets/images/intro/intro-logo.png" alt="" />
    <h1 id="page-title">Website Downloader</h1>
    <p class="subtitle">Download the source code and assets of any website.</p>

    <form class="download-form" id="downloadForm">
      <label class="sr-only" for="website">Website address</label>
      <input
        class="website-input"
        type="text"
        id="website"
        inputmode="url"
        autocomplete="url"
        autocapitalize="none"
        spellcheck="false"
        placeholder="https://www.google.com"
        aria-describedby="download-help"
        required
      />
      <button class="download-button" id="download" type="submit">
        <span class="glyphicon glyphicon-download" aria-hidden="true"></span>
        <span>Download</span>
      </button>
    </form>
    <p class="sr-only" id="download-help">Enter a website address such as example.com or https://example.com.</p>

    <div class="social-links">
      <a class="github-button" href="https://github.com/AhmadIbrahiim/Website-downloader" data-icon="octicon-star" data-size="large" data-show-count="true" aria-label="Star Website Downloader on GitHub">Star on GitHub</a>
      <a class="support-link" href="https://www.buymeacoffee.com/aibrahim" target="_blank" rel="noopener noreferrer">
        <img src="https://www.buymeacoffee.com/assets/img/custom_images/orange_img.png" alt="Support the project" />
      </a>
    </div>

    <section class="progress-panel" id="downloadProgress" hidden aria-labelledby="progress-title">
      <div class="progress-summary">
        <strong id="progress-title">Download status</strong>
        <span class="download-count" id="nFilesP">Files downloaded: <span id="nFiles">0</span></span>
      </div>
      <p class="progress-status" id="downloadStatus" role="status" aria-live="polite">Ready to download.</p>
      <pre class="log" id="log" aria-label="Download log"></pre>
    </section>

    <a class="result-button" id="downloadResult" href="">Download website assets</a>
  </section>
</main>
