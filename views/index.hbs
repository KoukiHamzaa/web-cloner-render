<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="WebCloner home">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" role="img"><path d="M8 4h10.5A5.5 5.5 0 0 1 24 9.5V20a5 5 0 0 1-5 5H8a4 4 0 0 1-4-4V8a4 4 0 0 1 4-4Z"/><path d="M12 8h8a3 3 0 0 1 3 3v8"/><path d="M10 13h8M10 17h5"/></svg>
      </span>
      <span class="brand-name">Web<span>Cloner</span></span>
    </a>
    <nav class="site-nav" aria-label="Primary navigation">
      <a href="#features">Features</a>
